{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Frappé"
  },
  "icon_theme": {
    "mode": "system",
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Frappé"
  },
  "ui_font_size": 14,
  "buffer_font_size": 12,
  "buffer_font_family": "Fira Code",

  "confirm_quit": true,
  "telemetry": {
    "diagnostics": true,
    "metrics": true
  },

  "show_edit_predictions": true,
  "edit_predictions": {
    "provider": "zed",
    "mode": "eager"
  },

  "format_on_save": "on",
  "use_on_type_format": true,
  "line_indicator_format": "short",
  "formatter": "prettier",
  "ensure_final_newline_on_save": true,

  "relative_line_numbers": "enabled",

  "languages": {
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      },
      "format_on_save": "on"
    }
  }
}
