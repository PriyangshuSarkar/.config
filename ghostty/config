########################################
# Ghostty Configuration (macOS Stable)
########################################
# File locations:
# ~/.config/ghostty/config  or
# ~/Library/Application Support/com.mitchellh.ghostty/config
#
# Syntax: key = value
# Comments start with #

########################################
# 1. Start-Up / Session Management
########################################

# Exit Ghostty when the last window closes
quit-after-last-window-closed = true

# Enable shell integration (Zsh)
shell-integration = zsh

# Preserve working directory across new windows/tabs
window-inherit-working-directory = true

########################################
# 2. Font & Cursor Configuration
########################################

font-family = "JetBrains Mono"
font-size = 12.5

# New windows inherit previous window’s font size
window-inherit-font-size = true

cursor-style = block
cursor-style-blink = false

########################################
# 3. Appearance & Theme
########################################

# Use Catppuccin themes (light/dark auto switch)
# theme = light:catppuccin-frappe.conf,dark:catppuccin-mocha.conf

# Use Catppuccin themes
theme = catppuccin-mocha.conf

# Background styling
background-opacity = 1
background-blur-radius = 0

########################################
# 4. Window Behavior (macOS)
########################################

window-decoration = auto
macos-non-native-fullscreen = false
macos-window-buttons = visible
macos-titlebar-style = hidden
macos-window-shadow = true
macos-option-as-alt = left
macos-shortcuts = allow

# Unbind default alt+arrow navigation
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = alt+up=unbind
keybind = alt+down=unbind

# Use Display P3 color space (Retina-compatible)
window-colorspace = display-p3

# Open new tabs at the end of the tab list
window-new-tab-position = end

# Save and restore window layout (default macOS behavior)
window-save-state = default

########################################
# 5. Scrolling & Buffer
########################################

# Scrollback buffer size (in bytes)
scrollback-limit = 20000000

########################################
# 6. Quality of Life
########################################

# Hide mouse cursor while typing
mouse-hide-while-typing = true

# Enable desktop notifications
desktop-notifications = true

########################################
# 7. Useful Keybindings
########################################

# Open Ghostty config in editor
keybind = cmd+,=open_config

# Reload configuration at runtime
keybind = cmd+shift+,=reload_config
