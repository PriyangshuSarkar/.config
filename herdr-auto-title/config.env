# herdr-auto-title settings — read once at startup
# Apply changes: herdr plugin action invoke herdr.auto-title.restart

# Nerd Font icon for what each pane runs (nvim, claude, shell, ssh…)
HERDR_AUTO_TITLE_ICONS=true

# Agent status in front of tab titles: ◉ idle, ◐ working, ● blocked, ✓ done
HERDR_AUTO_TITLE_AGENT_STATUS=true
