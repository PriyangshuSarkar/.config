{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "preserveAspectRatio": true,
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "type": "title",
      "keyWidth": 10,
    },
    "break",
    {
      "type": "separator",
    },
    {
      "type": "os",
      "key": "os",
      "keyColor": "blue",
    },
    {
      "type": "host",
      "key": " ",
      "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": " ",
      "keyColor": "blue",
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "blue",
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "blue",
    },
    {
      "type": "gpu",
      "key": "󰾲 ",
      "keyColor": "blue",
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "blue",
      "show": "model",
    },
    {
      "type": "localip",
      "key": "󰌗 ",
      "keyColor": "blue",
    },
    {
      "type": "separator",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m ",
    },
  ],
}
